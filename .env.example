# Copy to .env and change the password. solodesk refuses to start without one.
SOLODESK_PASSWORD=change-me-please

# Optional: keep only a hash in the environment instead of the password itself.
# Generate one with:  .venv/bin/python -m solodesk.auth
# SOLODESK_PASSWORD_HASH='scrypt$...'   (keep the single quotes: the hash contains $)

# Optional: where the SQLite database lives (default: ./data)
# SOLODESK_DATA_DIR=data

# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
# SOLODESK_COOKIE_SECURE=1
